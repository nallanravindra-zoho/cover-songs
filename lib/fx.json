    "b": "brightness (1 = unchanged)", "c": "contrast (1 = unchanged)", "s": "saturation (1 = unchanged, 0 = grey)", "h": "hue turn in degrees", "w": "warmth (-1 cool .. 1 warm)", "t": "tint (-1 green .. 1 magenta)",
    "f": "fade / lifted blacks (0..1)", "sep": "sepia (0..1)", "g": "black and white (0..1)", "v": "vignette, dark corners (0..1)", "n": "film grain (0..1)", "bl": "soft blur (pixels on a 1080-wide frame)"
  },
